generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  role      String   @default("unassigned") // 'student', 'teacher', or 'unassigned'
  provider  String   @default("local") // 'local' or 'google'
  googleId  String?  @unique
  avatar      String?
  studentCode String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  notes            Note[]
  noteFolders      NoteFolder[]
  quizzes          Quiz[]
  quizAttempts     QuizAttempt[]
  flashcards       Flashcard[]
  flashcardFolders FlashcardFolder[]
  chatSessions     ChatSession[]
  chatMessages     ChatMessage[]
  studySchedules   StudySchedule[]
  attendance       AttendanceRecord[]
  pushReceived     TeacherPushAssignment[] @relation("StudentPushAssignments")
  pushSent         TeacherPushAssignment[] @relation("TeacherPushAssignments")
  examsCreated     Exam[]      @relation("TeacherExams")
  examScores       ExamScore[] @relation("StudentExamScores")
  studentsMapped   TeacherStudent[] @relation("TeacherStudents")
  teachersMapped   TeacherStudent[] @relation("StudentTeachers")
}

model StudentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        String?
  course             String?
  semester           String?
  learningPreference String?
  totalStudyHours    Int      @default(0)
  createdAt          DateTime @default(now())
}

model TeacherProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   String?
  department     String?
  subject        String?
  specialization String?
  experience     Int?
  createdAt      DateTime @default(now())
}

model NoteFolder {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  notes Note[]
}

model Note {
  id        String      @id @default(uuid())
  title     String
  filePath  String
  fileType  String
  folderId  String?
  folder    NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  studentId String
  student   User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  quizzes         Quiz[]
  flashcards      Flashcard[]
  chatMessages    ChatMessage[]
  pushAssignments TeacherPushAssignment[]

  @@index([studentId])
  @@index([folderId])
}

model Quiz {
  id            String   @id @default(uuid())
  title         String
  difficulty    String   @default("medium") // easy, medium, hard
  questionsJson String // Stores JSON array of QuizQuestion
  noteId        String?
  note          Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  attempts        QuizAttempt[]
  pushAssignments TeacherPushAssignment[]

  @@index([studentId])
}

model QuizAttempt {
  id             String   @id @default(uuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score          Int
  totalQuestions Int
  accuracy       Int
  weakTopicsJson String // Stores JSON array of weak topics
  createdAt      DateTime @default(now())

  @@index([studentId])
}

model FlashcardFolder {
  id        String   @id @default(uuid())
  name      String
  topic     String?
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  noteId    String?
  createdAt DateTime @default(now())

  flashcards Flashcard[]
}

model Flashcard {
  id        String           @id @default(uuid())
  question  String
  answer    String
  topic     String
  type      String           @default("concept") // definition, concept, formula, comparison
  folderId  String?
  folder    FlashcardFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  noteId    String?
  note      Note?            @relation(fields: [noteId], references: [id], onDelete: SetNull)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([studentId])
  @@index([folderId])
}

model ChatSession {
  id        String   @id @default(uuid())
  title     String
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id          String       @id @default(uuid())
  studentId   String
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  noteId      String?
  note        Note?        @relation(fields: [noteId], references: [id], onDelete: SetNull)
  question    String
  answer      String
  sourcesJson String // Stores JSON array of ChatSource
  createdAt   DateTime     @default(now())

  @@index([studentId])
  @@index([sessionId])
}

model StudySchedule {
  id           String   @id @default(uuid())
  studentId    String
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examDate     String
  subject      String
  dailyHours   Int      @default(2)
  scheduleJson String // Stores JSON array of daily study blocks
  createdAt    DateTime @default(now())

  @@index([studentId])
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   String
  status    String   @default("present") // present or absent
  date      String
  createdAt DateTime @default(now())
}

model TeacherPushAssignment {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation("TeacherPushAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentPushAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  noteId    String?
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  quizId    String?
  quiz      Quiz?    @relation(fields: [quizId], references: [id], onDelete: SetNull)
  dueDate   String?
  status    String   @default("pending") // pending or completed
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([teacherId])
}

model Exam {
  id        String   @id @default(uuid())
  title     String
  subject   String
  maxMarks  Int
  examDate  String
  teacherId String
  teacher   User     @relation("TeacherExams", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  scores ExamScore[]

  @@index([teacherId])
}

model ExamScore {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentExamScores", fields: [studentId], references: [id], onDelete: Cascade)
  marks     Int
  createdAt DateTime @default(now())

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId])
}

model TeacherStudent {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentTeachers", fields: [studentId], references: [id], onDelete: Cascade)
  subject   String?
  createdAt DateTime @default(now())

  @@unique([teacherId, studentId])
  @@index([teacherId])
  @@index([studentId])
}

